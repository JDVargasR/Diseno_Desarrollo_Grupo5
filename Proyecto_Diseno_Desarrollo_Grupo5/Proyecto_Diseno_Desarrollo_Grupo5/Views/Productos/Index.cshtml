@using System.Web
@model Proyecto_Diseno_Desarrollo_Grupo5.Models.ProductoCrudVM
@{
    ViewBag.Title = "Productos";
    var esSoloLectura = ViewBag.EsSoloLectura != null && (bool)ViewBag.EsSoloLectura;
}

@section styles {
    <link rel="stylesheet" href="~/StaticFiles/css/Cliente.css" />
}

<div class="container" style="max-width:1100px; padding-top:30px;">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h2 class="page-title">Control de Productos</h2>
            <div class="page-subtitle">Aqui podras gestionar los diversos productos del sistema.</div>
        </div>

        @if (!esSoloLectura)
        {
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrear">
                + Nuevo Producto
            </button>
        }
    </div>

    @if (TempData["OK"] != null)
    {
        <div class="alert alert-success cardx" style="padding:12px 14px;">@TempData["OK"]</div>
    }
    @if (TempData["ERR"] != null)
    {
        <div class="alert alert-danger cardx" style="padding:12px 14px;">@TempData["ERR"]</div>
    }
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-warning cardx" style="padding:12px 14px;">@TempData["Mensaje"]</div>
    }

    <div class="page-section mb-3">
        @using (Html.BeginForm("Index", "Productos", FormMethod.Get))
        {
            <div class="row g-2 align-items-end">
                <div class="col-md-9">
                    <label class="form-label" style="font-weight:600;">Buscar</label>
                    <input type="text" name="q" value="@Model.Q" class="form-control" placeholder="Nombre o categoría" maxlength="100" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-dark w-100" style="height:44px; border-radius:10px; font-weight:600;">🔎 Buscar</button>
                </div>
            </div>
        }
    </div>

    <div class="page-section mt-3">
        <div class="cardx table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Categoría</th>
                        <th>Estado</th>
                        @if (!esSoloLectura)
                        {
                            <th style="width:220px; text-align:right;">Acciones</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Productos)
                    {
                        <tr>
                            <td>@p.NOMBRE</td>
                            <td>₡@p.PRECIO_VENTA.ToString("N2")</td>
                            <td>
                                <span class="badge @(p.STOCK <= 0 ? "bg-danger" : (p.STOCK < 10 ? "bg-warning" : "bg-secondary"))">
                                    @p.STOCK.ToString("N2")
                                </span>
                            </td>
                            <td>@p.CATEGORIA</td>
                            <td>
                                <span class="badge-pill @(p.ID_ESTADO == 1 ? "badge-ok" : "badge-off")">
                                    @(p.ID_ESTADO == 1 ? "ACTIVO" : "INACTIVO")
                                </span>
                            </td>
                            @if (!esSoloLectura)
                            {
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm me-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEditar"
                                            onclick="cargarProductoEditar('@p.ID_PRODUCTO', '@Html.Raw(HttpUtility.JavaScriptStringEncode(p.NOMBRE ?? ""))', '@(p.PRECIO_VENTA.ToString(System.Globalization.CultureInfo.InvariantCulture))', '@p.ID_CATEGORIA', '@(p.STOCK.ToString(System.Globalization.CultureInfo.InvariantCulture))')">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    @using (Html.BeginForm("ToggleActive", "Productos", FormMethod.Post, new { style = "display:inline;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.ID_PRODUCTO" />
                                        <input type="hidden" name="page" value="@Model.Page" />
                                        <input type="hidden" name="q" value="@Model.Q" />

                                        if (p.ID_ESTADO == 1)
                                        {
                                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return AlphaConfirm.antes(event, { titulo: '¿Inactivar este producto?', texto: 'El producto dejará de estar disponible para la venta.', afectaInventario: false, icono: 'warning' });" title="Inactivar">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-outline-success btn-sm" onclick="return AlphaConfirm.antes(event, { titulo: '¿Activar este producto?', texto: 'El producto volverá a estar disponible para la venta.', afectaInventario: false, icono: 'question' });" title="Activar">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        }
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav aria-label="Paginación" class="mt-3">
            <ul class="pagination">
                @{
                    var current = Model.Page;
                    var total = Model.TotalPages;
                    int start = Math.Max(1, current - 2);
                    int end = Math.Min(total, current + 2);
                }

                <li class="page-item @(current == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { q = Model.Q, page = current - 1 })">Anterior</a>
                </li>

                @for (int i = start; i <= end; i++)
                {
                    <li class="page-item @(i == current ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { q = Model.Q, page = i })">@i</a>
                    </li>
                }

                <li class="page-item @(current >= total ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { q = Model.Q, page = current + 1 })">Siguiente</a>
                </li>
            </ul>
        </nav>
    </div>
</div>

@if (!esSoloLectura)
{
    <div class="modal fade" id="modalCrear" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" style="font-weight:900;">Nuevo producto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                @using (Html.BeginForm("Create", "Productos", FormMethod.Post, new { id = "formCrearProducto", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Page" value="@Model.Page" />
                    <input type="hidden" name="Q" value="@Model.Q" />
                    <div class="modal-body">

                        <div id="crear-errores" class="alert alert-danger d-none" role="alert"></div>

                        <div class="mb-2">
                            <label class="form-label">Nombre <span class="text-danger">*</span></label>
                            <input class="form-control" name="NOMBRE" id="crear_NOMBRE"
                                   maxlength="140"
                                   placeholder="Nombre del producto" />
                            <small class="text-muted">Máximo 140 caracteres. Solo letras, números y espacios.</small>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Precio de venta (₡) <span class="text-danger">*</span></label>
                            <input class="form-control" name="PRECIO_VENTA" id="crear_PRECIO_VENTA"
                                   type="number" step="0.01" min="0.01" max="10000000"
                                   placeholder="Ej: 1500.00" />
                            <small class="text-muted">Entre ₡0.01 y ₡10,000,000.</small>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Categoría <span class="text-danger">*</span></label>
                            <select class="form-select" name="ID_CATEGORIA" id="crear_ID_CATEGORIA">
                                <option value="">-- Seleccione --</option>
                                @foreach (var c in Model.Categorias)
                                {
                                    <option value="@c.Value">@c.Text</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Stock <span class="text-danger">*</span></label>
                            <input class="form-control" name="STOCK" id="crear_STOCK"
                                   type="number" step="0.01" min="0" value="0" />
                            <small class="text-muted">Cantidad disponible en inventario.</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" class="btn btn-primary btn-primary-pill" onclick="validarYEnviarProducto('formCrearProducto','crear')">Guardar</button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalEditar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" style="font-weight:900;">Editar producto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                @using (Html.BeginForm("Edit", "Productos", FormMethod.Post, new { id = "formEditarProducto", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ID_PRODUCTO" id="edit_ID_PRODUCTO" />
                    <input type="hidden" name="Page" value="@Model.Page" />
                    <input type="hidden" name="Q" value="@Model.Q" />
                    <div class="modal-body">

                        <div id="editar-errores" class="alert alert-danger d-none" role="alert"></div>

                        <div class="mb-2">
                            <label class="form-label">Nombre <span class="text-danger">*</span></label>
                            <input class="form-control" name="NOMBRE" id="edit_NOMBRE"
                                   maxlength="140"
                                   placeholder="Nombre del producto" />
                            <small class="text-muted">Máximo 140 caracteres.</small>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Precio de venta (₡) <span class="text-danger">*</span></label>
                            <input class="form-control" name="PRECIO_VENTA" id="edit_PRECIO_VENTA"
                                   type="number" step="0.01" min="0.01" max="10000000"
                                   placeholder="Ej: 1500.00" />
                            <small class="text-muted">Entre ₡0.01 y ₡10,000,000.</small>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Categoría <span class="text-danger">*</span></label>
                            <select class="form-select" name="ID_CATEGORIA" id="edit_ID_CATEGORIA">
                                @foreach (var c in Model.Categorias)
                                {
                                    <option value="@c.Value">@c.Text</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Stock <span class="text-danger">*</span></label>
                            <input class="form-control" name="STOCK" id="edit_STOCK"
                                   type="number" step="0.01" min="0" />
                            <small class="text-muted">Cantidad disponible en inventario.</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" class="btn btn-primary btn-primary-pill" onclick="validarYEnviarProducto('formEditarProducto','editar')">Guardar cambios</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

<script>
    var _productoEditarPendiente = null;

    function cargarProductoEditar(id, nombre, precio, idCategoria, stock) {
        _productoEditarPendiente = {
            id: id,
            nombre: nombre,
            precio: String(precio).replace(/,/g, '.'),
            idCategoria: idCategoria,
            stock: String(stock).replace(/,/g, '.')
        };
    }

    document.addEventListener('DOMContentLoaded', function () {
        var modalEditar = document.getElementById('modalEditar');
        if (modalEditar) {
            modalEditar.addEventListener('shown.bs.modal', function () {
                if (_productoEditarPendiente) {
                    var d = _productoEditarPendiente;
                    document.getElementById("edit_ID_PRODUCTO").value = d.id;
                    document.getElementById("edit_NOMBRE").value = d.nombre;
                    document.getElementById("edit_ID_CATEGORIA").value = d.idCategoria;

                    setTimeout(function () {
                        var precioEl = document.getElementById("edit_PRECIO_VENTA");
                        var stockEl = document.getElementById("edit_STOCK");
                        precioEl.value = d.precio;
                        stockEl.value = d.stock;
                        precioEl.dispatchEvent(new Event('input'));
                        stockEl.dispatchEvent(new Event('input'));
                    }, 50);

                    ocultarErrores('editar-errores');
                    _productoEditarPendiente = null;
                }
            });
        }

        var modalCrear = document.getElementById('modalCrear');
        if (modalCrear) {
            modalCrear.addEventListener('show.bs.modal', function () {
                ocultarErrores('crear-errores');
            });
        }
    });

    function mostrarErrores(contenedorId, errores) {
        var el = document.getElementById(contenedorId);
        if (!el) return;
        el.innerHTML = '<strong>Por favor corrija los siguientes errores:</strong><ul class="mb-0 mt-1">'
            + errores.map(function (e) { return '<li>' + e + '</li>'; }).join('')
            + '</ul>';
        el.classList.remove('d-none');
    }

    function ocultarErrores(contenedorId) {
        var el = document.getElementById(contenedorId);
        if (el) { el.innerHTML = ''; el.classList.add('d-none'); }
    }

    function validarYEnviarProducto(formId, prefijo) {
        var errores = [];
        var errorContenedor = prefijo === 'crear' ? 'crear-errores' : 'editar-errores';

        var nombre = document.getElementById(prefijo === 'crear' ? 'crear_NOMBRE' : 'edit_NOMBRE');
        var nombreVal = nombre ? nombre.value.trim() : '';
        if (!nombreVal) {
            errores.push('El nombre del producto es obligatorio.');
        } else if (nombreVal.length > 140) {
            errores.push('El nombre no puede superar los 140 caracteres (actualmente tiene ' + nombreVal.length + ').');
        } else if (!/^[A-Za-zÁÉÍÓÚáéíóúÑñ0-9 \-_.,()]+$/.test(nombreVal)) {
            errores.push('El nombre contiene caracteres no permitidos. Use letras, números, espacios y signos básicos (-, _, ., ,).');
        }

        var precioId = prefijo === 'crear' ? 'crear_PRECIO_VENTA' : 'edit_PRECIO_VENTA';
        var precioEl = document.getElementById(precioId);
        var precioStr = precioEl ? precioEl.value.trim() : '';
        if (precioStr === '') {
            errores.push('El precio de venta es obligatorio.');
        } else {
            var precio = parseFloat(precioStr);
            if (isNaN(precio)) {
                errores.push('El precio de venta debe ser un número válido.');
            } else if (precio < 0.01) {
                errores.push('El precio de venta debe ser al menos ₡0.01.');
            } else if (precio > 10000000) {
                errores.push('El precio de venta no puede superar ₡10,000,000.');
            } else {
                var partes = precioStr.split('.');
                if (partes[1] && partes[1].length > 2) {
                    errores.push('El precio de venta puede tener máximo 2 decimales.');
                }
            }
        }

        var catId = prefijo === 'crear' ? 'crear_ID_CATEGORIA' : 'edit_ID_CATEGORIA';
        var catEl = document.getElementById(catId);
        if (!catEl || !catEl.value) {
            errores.push('Debe seleccionar una categoría.');
        }

        var stockId = prefijo === 'crear' ? 'crear_STOCK' : 'edit_STOCK';
        var stockEl = document.getElementById(stockId);
        var stockStr = stockEl ? stockEl.value.trim() : '';
        if (stockStr === '') {
            errores.push('El stock es obligatorio (puede ser 0).');
        } else {
            var stock = parseFloat(stockStr);
            if (isNaN(stock)) {
                errores.push('El stock debe ser un número válido.');
            } else if (stock < 0) {
                errores.push('El stock no puede ser negativo.');
            }
        }

        if (errores.length > 0) {
            mostrarErrores(errorContenedor, errores);
            return;
        }

        ocultarErrores(errorContenedor);

        var esEdicion = prefijo !== 'crear';
        AlphaConfirm.preguntar({
            titulo: esEdicion ? '¿Guardar cambios del producto?' : '¿Guardar nuevo producto?',
            texto: esEdicion ? 'Se actualizará la información de este producto.' : 'Se creará un nuevo producto en el catálogo.',
            afectaInventario: false,
            icono: 'question'
        }).then(function (confirmado) {
            if (confirmado) {
                document.getElementById(formId).submit();
            }
        });
    }
</script>
