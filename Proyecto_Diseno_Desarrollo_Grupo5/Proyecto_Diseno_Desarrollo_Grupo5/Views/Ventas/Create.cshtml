@model Proyecto_Diseno_Desarrollo_Grupo5.Models.VentaCrearVM
@{
    ViewBag.Title = "Nueva venta";
}

@section styles{
    <link rel="stylesheet" href="~/StaticFiles/css/Cliente.css" />
    <link rel="stylesheet" href="~/StaticFiles/css/Ventas.css" />
}

<div class="container" style="max-width:1100px; padding-top:30px;">

    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h2 class="page-title">Nueva venta</h2>
            <div class="page-subtitle">Agregá productos, calculá total y guardá la transacción</div>
        </div>

        <a class="btn btn-outline-secondary" href="@Url.Action("Index","Ventas")">Volver</a>
    </div>

    @if (TempData["ERR"] != null)
    {
        <div class="alert alert-danger cardx" style="padding:12px 14px;">@TempData["ERR"]</div>
    }

    @using (Html.BeginForm("Create", "Ventas", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="page-section mb-3">
            <div class="row g-3 align-items-start">
                <div class="col-md-7 position-relative">
                    <label class="form-label" style="font-weight:600;">Cliente</label>

                    <input type="text"
                           id="clienteBusqueda"
                           class="form-control"
                           placeholder="Escriba nombre, teléfono o correo..."
                           autocomplete="off" />

                    <input type="hidden" name="IdCliente" id="IdCliente" required />

                    <div id="clienteResultados" class="cliente-resultados d-none"></div>

                    <small id="clienteSeleccionadoTxt" class="text-muted d-block mt-2">
                        No hay cliente seleccionado.
                    </small>
                </div>

                <div class="col-md-5">
                    <label class="form-label" style="font-weight:600;">Total</label>
                    <div class="cardx" style="padding:14px 16px;">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted" style="font-weight:700;">Monto total</span>
                            <span style="font-weight:900; font-size:22px;">₡<span id="totalTxt">0.00</span></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="page-section mb-3">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label" style="font-weight:600;">Tipo de ítem</label>
                    <select id="tipoItemSelect" class="form-select">
                        <option value="PRODUCTO">Producto</option>
                        <option value="MATERIAL">Material</option>
                    </select>
                </div>

                <div class="col-md-4" id="productoSelectWrap">
                    <label class="form-label" style="font-weight:600;">Producto</label>
                    @Html.DropDownList("productoSelect", Model.Productos, "Seleccione un producto", new { @class = "form-select" })
                </div>

                <div class="col-md-4 d-none" id="materialSelectWrap">
                    <label class="form-label" style="font-weight:600;">Material</label>
                    @Html.DropDownList("materialSelect", Model.Materiales, "Seleccione un material", new { @class = "form-select" })
                </div>

                <div class="col-md-2">
                    <label class="form-label" style="font-weight:600;">Cantidad</label>
                    <input class="form-control" type="number" step="0.01" min="0.01" id="cantInput" />
                </div>

                <div class="col-md-2">
                    <label class="form-label" style="font-weight:600;">Precio Unitario (₡)</label>
                    <input class="form-control" type="number" step="0.01" min="0" id="precioInput" />
                </div>

                <div class="col-md-1">
                    <button type="button" class="btn btn-dark w-100" style="height:44px; border-radius:10px; font-weight:600;" onclick="agregarItem()">
                        + Agregar
                    </button>
                </div>
            </div>
        </div>

        <div class="page-section">
            <div class="cardx table-wrap">
                <table class="table mb-0" id="tablaDetalle">
                    <thead>
                        <tr>
                            <th style="width:100px;">Tipo</th>
                            <th>Ítem</th>
                            <th style="width:120px;">Cantidad</th>
                            <th style="width:150px;">Precio</th>
                            <th style="width:150px;">Subtotal</th>
                            <th style="width:120px; text-align:right;">Acción</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="submit" class="btn btn-primary btn-primary-pill" onclick="return AlphaConfirm.antes(event, { titulo: '¿Guardar esta venta?', texto: 'Se descontará el stock de los materiales usados en los productos vendidos.', afectaInventario: true, icono: 'question' });">Guardar venta</button>
            </div>
        </div>

        <div id="hiddenContainer"></div>
    }

</div>

@section scripts{
    <script>
        const productosPrecio = {
        @for (int i = 0; i < Model.ProductosConPrecio.Count; i++)
        {
            var p = Model.ProductosConPrecio[i];
        <text>
            "@p.IdProducto": @p.PrecioVenta.ToString(System.Globalization.CultureInfo.InvariantCulture)@(i < Model.ProductosConPrecio.Count - 1 ? "," : "")
        </text>
        }
        };

        const materialesPrecio = {
        @for (int i = 0; i < Model.MaterialesConPrecio.Count; i++)
        {
            var m = Model.MaterialesConPrecio[i];
        <text>
            "@m.IdMaterial": @m.PrecioVenta.ToString(System.Globalization.CultureInfo.InvariantCulture)@(i < Model.MaterialesConPrecio.Count - 1 ? "," : "")
        </text>
        }
        };

        const tipoItemSelect = document.getElementById("tipoItemSelect");
        const productoSelectWrap = document.getElementById("productoSelectWrap");
        const materialSelectWrap = document.getElementById("materialSelectWrap");

        tipoItemSelect.addEventListener("change", function () {
            const precioInput = document.getElementById("precioInput");
            if (this.value === "MATERIAL") {
                productoSelectWrap.classList.add("d-none");
                materialSelectWrap.classList.remove("d-none");
            } else {
                materialSelectWrap.classList.add("d-none");
                productoSelectWrap.classList.remove("d-none");
            }
            precioInput.value = "";
        });

        document.getElementsByName("productoSelect")[0].addEventListener("change", function () {
            const idProd = this.value;
            const precioInput = document.getElementById("precioInput");

            if (idProd && productosPrecio[idProd] !== undefined) {
                precioInput.value = productosPrecio[idProd];
            } else {
                precioInput.value = "";
            }
        });

        document.getElementsByName("materialSelect")[0].addEventListener("change", function () {
            const idMat = this.value;
            const precioInput = document.getElementById("precioInput");

            if (idMat && materialesPrecio[idMat] !== undefined) {
                precioInput.value = materialesPrecio[idMat];
            } else {
                precioInput.value = "";
            }
        });

        // Evita que presionar Enter en Cantidad/Precio dispare el submit del formulario
        // (envío accidental de la venta vacía) en lugar de agregar el producto a la lista.
        ["cantInput", "precioInput"].forEach(function (id) {
            document.getElementById(id).addEventListener("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    agregarItem();
                }
            });
        });

        function money(n) {
            return (Math.round(n * 100) / 100).toFixed(2);
        }

        function recalcularTotal() {
            let total = 0;
            document.querySelectorAll("#tablaDetalle tbody tr").forEach(tr => {
                total += parseFloat(tr.getAttribute("data-subtotal")) || 0;
            });
            document.getElementById("totalTxt").innerText = money(total);
        }

        function agregarItem() {
            const tipo = tipoItemSelect.value;
            const isMaterial = tipo === "MATERIAL";
            const sel = isMaterial
                ? document.getElementsByName("materialSelect")[0]
                : document.getElementsByName("productoSelect")[0];

            const idSel = sel.value;
            const itemText = sel.options[sel.selectedIndex]?.text || "";

            const cant = parseFloat(document.getElementById("cantInput").value);
            const precio = parseFloat(document.getElementById("precioInput").value);

            if (!idSel) { alert(isMaterial ? "Seleccione un material" : "Seleccione un producto"); return; }
            if (!cant || cant <= 0) { alert("Cantidad inválida"); return; }
            if (precio == null || isNaN(precio) || precio < 0) { alert("Precio inválido"); return; }

            const subtotal = cant * precio;

            const tbody = document.querySelector("#tablaDetalle tbody");
            const tr = document.createElement("tr");
            tr.setAttribute("data-subtotal", subtotal);

            tr.innerHTML = `
                <td>${isMaterial ? "Material" : "Producto"}</td>
                <td>${itemText}</td>
                <td>${money(cant)}</td>
                <td>${money(precio)}</td>
                <td>${money(subtotal)}</td>
                <td class="text-end">
                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="quitarItem(this)">Quitar</button>
                </td>
            `;
            tbody.appendChild(tr);

            const hidden = document.getElementById("hiddenContainer");
            hidden.insertAdjacentHTML("beforeend", `
                <input type="hidden" name="TipoItem" value="${tipo}" />
                <input type="hidden" name="IdProducto" value="${isMaterial ? "" : idSel}" />
                <input type="hidden" name="IdMaterial" value="${isMaterial ? idSel : ""}" />
                <input type="hidden" name="Cantidad" value="${cant}" />
                <input type="hidden" name="PrecioUnitario" value="${precio}" />
            `);

            document.getElementById("cantInput").value = "";
            document.getElementById("precioInput").value = "";
            sel.selectedIndex = 0;

            recalcularTotal();
        }

        function quitarItem(btn) {
            const tr = btn.closest("tr");
            const index = Array.from(tr.parentNode.children).indexOf(tr);

            tr.remove();

            const hidden = document.querySelectorAll("#hiddenContainer input");
            const base = index * 5;
            for (let k = 0; k < 5; k++) {
                if (hidden[base + k]) hidden[base + k].remove();
            }

            recalcularTotal();
        }

        // ===== BUSCADOR PROFESIONAL DE CLIENTES =====
        const clienteBusqueda = document.getElementById("clienteBusqueda");
        const clienteResultados = document.getElementById("clienteResultados");
        const idClienteInput = document.getElementById("IdCliente");
        const clienteSeleccionadoTxt = document.getElementById("clienteSeleccionadoTxt");

        let timeoutCliente = null;

        clienteBusqueda.addEventListener("keyup", function () {
            const valor = this.value.trim();

            idClienteInput.value = "";
            clienteSeleccionadoTxt.innerText = "No hay cliente seleccionado.";

            clearTimeout(timeoutCliente);

            if (valor.length < 2) {
                clienteResultados.innerHTML = "";
                clienteResultados.classList.add("d-none");
                return;
            }

            timeoutCliente = setTimeout(function () {
                fetch('@Url.Action("BuscarClientes", "Ventas")?term=' + encodeURIComponent(valor))
                    .then(r => r.json())
                    .then(data => {
                        clienteResultados.innerHTML = "";

                        if (!data || data.length === 0) {
                            clienteResultados.innerHTML = `
                                <div class="cliente-item">
                                    <b>Sin resultados</b>
                                    <span>No se encontraron clientes.</span>
                                </div>`;
                            clienteResultados.classList.remove("d-none");
                            return;
                        }

                        data.forEach(c => {
                            const item = document.createElement("div");
                            item.className = "cliente-item";
                            item.innerHTML = `
                                <b>${c.nombre}</b>
                                <span>${c.telefono || ""} ${c.correo ? "· " + c.correo : ""}</span>
                            `;

                            item.addEventListener("click", function () {
                                clienteBusqueda.value = c.nombre;
                                idClienteInput.value = c.id;
                                clienteSeleccionadoTxt.innerText = "Cliente seleccionado: " + c.nombre;
                                clienteResultados.classList.add("d-none");
                            });

                            clienteResultados.appendChild(item);
                        });

                        clienteResultados.classList.remove("d-none");
                    });
            }, 250);
        });

        document.addEventListener("click", function (e) {
            if (!clienteBusqueda.contains(e.target) && !clienteResultados.contains(e.target)) {
                clienteResultados.classList.add("d-none");
            }
        });
    </script>
}