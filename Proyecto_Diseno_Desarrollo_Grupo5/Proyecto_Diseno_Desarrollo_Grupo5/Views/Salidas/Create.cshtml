@model Proyecto_Diseno_Desarrollo_Grupo5.Models.MovimientoInventarioFormVM
@{
    var esEntrada = (Model.Tipo ?? "").ToUpperInvariant() == "ENTRADA";
    ViewBag.Title = esEntrada ? "Registrar entrada" : "Registrar salida";
}

@section styles{
    <link rel="stylesheet" href="~/StaticFiles/css/Cliente.css" />
}

<div class="container" style="max-width:900px; padding-top:30px;">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h2 class="page-title">@(esEntrada ? "Registrar ingreso" : "Registrar salida")</h2>
            <div class="page-subtitle">Complete los datos para actualizar inventario</div>
        </div>
        <a class="btn btn-outline-dark" href="@Url.Action("Index","Salidas")">Volver</a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-warning cardx" style="padding:12px 14px;">@TempData["Mensaje"]</div>
    }

    @using (Html.BeginForm(esEntrada ? "CreateEntrada" : "CreateSalida", "Salidas", FormMethod.Post, new { @class = "page-section" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(x => x.Tipo)

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" style="font-weight:700;">Producto/Material</label>
                @Html.DropDownListFor(x => x.IdMaterial, Model.Materiales, "Seleccione...", new { @class = "form-select", required = "required" })
            </div>
            <div class="col-md-3">
                <label class="form-label" style="font-weight:700;">Cantidad</label>
                @Html.TextBoxFor(x => x.Cantidad, new { @class = "form-control", type = "number", step = "0.01", min = "0.01", required = "required" })
            </div>
            <div class="col-md-3">
                <label class="form-label" style="font-weight:700;">Fecha</label>
                @Html.TextBoxFor(x => x.Fecha, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", required = "required" })
            </div>
            <div class="col-12">
                <label class="form-label" style="font-weight:700;">Motivo</label>
                @Html.TextAreaFor(x => x.Motivo, new { @class = "form-control", rows = 3, maxlength = "150", required = "required" })
            </div>
            <div class="col-12 d-flex justify-content-end gap-2 mt-2">
                <a href="@Url.Action("Index","Salidas")" class="btn btn-light">Cancelar</a>
                <button type="submit" class="btn @(esEntrada ? "btn-success" : "btn-danger")">@(esEntrada ? "Guardar ingreso" : "Guardar salida")</button>
            </div>
        </div>
    }
</div>
