@model Proyecto_Diseno_Desarrollo_Grupo5.Models.MovimientoInventarioIndexVM
@{
    ViewBag.Title = "Movimientos de inventario";
}

@section styles{
    <link rel="stylesheet" href="~/StaticFiles/css/Cliente.css" />
    <style>
        .badge-mov {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 999px;
            font-weight: 700;
            font-size: 12px;
            letter-spacing: .3px;
        }
        .badge-mov-entrada { background: #d1f2e0; color: #0f6b3a; }
        .badge-mov-salida { background: #fde2e1; color: #a3271e; }
        .badge-mov-pendiente { background: #fff3cd; color: #7a5b00; }
        .badge-mov-confirmado { background: #dbeafe; color: #1d4ed8; }
        .badge-mov-anulado { background: #e5e7eb; color: #4b5563; text-decoration: line-through; }
        .salidas-empty {
            text-align: center;
            padding: 48px 18px;
            color: #6c757d;
        }
        .salidas-empty i {
            font-size: 42px;
            display: block;
            margin-bottom: 10px;
            opacity: .6;
        }
    </style>
}

<div class="container" style="max-width:1200px; padding-top:30px;">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h2 class="page-title">Movimientos de inventario</h2>
            <div class="page-subtitle">Ingresos y salidas de productos/materiales</div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-success" href="@Url.Action("CreateEntrada","Salidas")">+ Registrar entrada</a>
            <a class="btn btn-outline-danger" href="@Url.Action("CreateSalida","Salidas")">+ Registrar salida</a>
        </div>
    </div>

    @if (TempData["OK"] != null)
    {
        <div class="alert alert-success cardx" style="padding:12px 14px;">@TempData["OK"]</div>
    }

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-warning cardx" style="padding:12px 14px;">@TempData["Mensaje"]</div>
    }

    <form method="get" class="page-section mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label" style="font-weight:700;">Tipo</label>
                <select class="form-select" name="tipo">
                    <option value="" @(string.IsNullOrWhiteSpace(Model.Tipo) ? "selected" : "")>Todos</option>
                    <option value="ENTRADA" @(Model.Tipo == "ENTRADA" ? "selected" : "")>Entradas</option>
                    <option value="SALIDA" @(Model.Tipo == "SALIDA" ? "selected" : "")>Salidas</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" style="font-weight:700;">Producto/Material</label>
                <select class="form-select" name="idMaterial">
                    <option value="">Todos</option>
                    @foreach (var m in Model.Materiales)
                    {
                        <option value="@m.Value" @(Model.IdMaterial.HasValue && Model.IdMaterial.Value.ToString() == m.Value ? "selected" : "")>@m.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" style="font-weight:700;">Desde</label>
                <input class="form-control" type="date" name="desde" value="@(Model.Desde.HasValue ? Model.Desde.Value.ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="col-md-2">
                <label class="form-label" style="font-weight:700;">Hasta</label>
                <input class="form-control" type="date" name="hasta" value="@(Model.Hasta.HasValue ? Model.Hasta.Value.ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="col-md-2">
                <label class="form-label" style="font-weight:700;">Buscar</label>
                <input class="form-control" name="q" value="@Model.Q" placeholder="motivo..." />
            </div>
            <div class="col-md-1 d-grid">
                <button class="btn btn-dark" type="submit">Filtrar</button>
            </div>
        </div>
    </form>

    <div class="page-section">
        <div class="cardx table-wrap">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Material</th>
                        <th>Proveedor</th>
                        <th>Cantidad</th>
                        <th>Motivo</th>
                        <th>Estado</th>
                        <th style="width:220px; text-align:right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Movimientos != null && Model.Movimientos.Count > 0)
                    {
                        foreach (var item in Model.Movimientos)
                        {
                            var tipoClase = string.Equals(item.Tipo, "ENTRADA", StringComparison.OrdinalIgnoreCase) ? "badge-mov-entrada" : "badge-mov-salida";
                            var estadoClase = string.Equals(item.Estado, "ANULADO", StringComparison.OrdinalIgnoreCase)
                                ? "badge-mov-anulado"
                                : string.Equals(item.Estado, "PENDIENTE", StringComparison.OrdinalIgnoreCase)
                                    ? "badge-mov-pendiente"
                                    : "badge-mov-confirmado";

                            <tr>
                                <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="badge-mov @tipoClase">@item.Tipo</span></td>
                                <td>@item.Material</td>
                                <td>@item.Proveedor</td>
                                <td>@item.Cantidad.ToString("N2")</td>
                                <td>@item.Motivo</td>
                                <td><span class="badge-mov @estadoClase">@item.Estado</span></td>
                                <td class="text-end">
                                    <a class="btn btn-outline-info btn-sm" href="@Url.Action("Comprobante","Salidas", new { id = item.IdMovimiento })">Comprobante</a>
                                    @if (item.PuedeAnular)
                                    {
                                        <form method="post" action="@Url.Action("Anular","Salidas")" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.IdMovimiento" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return AlphaConfirm.antes(event, { titulo: '¿Anular este movimiento?', texto: 'Esta acción afecta el inventario y revertirá el efecto del movimiento sobre el stock.', afectaInventario: true, icono: 'warning' });">Anular</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">
                                <div class="salidas-empty">
                                    <i class="bi bi-inbox"></i>
                                    No hay movimientos para los filtros seleccionados.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

