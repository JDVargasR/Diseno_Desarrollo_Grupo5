@model Proyecto_Diseno_Desarrollo_Grupo5.Models.Reportes.DesperdicioAnalisisVM

@{
    ViewBag.Title = "Reportes - Analisis de Desperdicios";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>

<div class="lp-container mt-4 desperdicios-analisis-page">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2><i class="bi bi-file-earmark-bar-graph"></i> Analisis de Desperdicios</h2>
            <p class="text-muted">Analisis detallado de desperdicios de material en el periodo seleccionado</p>
        </div>
    </div>

    <!-- Filtro de fechas -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <form method="get" id="formFiltroDesperdicios" class="row g-3">
                        <div class="col-md-3">
                            <label for="fechaInicio" class="form-label">Fecha Inicio</label>
                            <input type="date" class="form-control" id="fechaInicio" name="fechaInicio" value="@ViewBag.FechaInicio" />
                        </div>
                        <div class="col-md-3">
                            <label for="fechaFin" class="form-label">Fecha Fin</label>
                            <input type="date" class="form-control" id="fechaFin" name="fechaFin" value="@ViewBag.FechaFin" />
                        </div>
                        <div class="col-md-2">
                            <label>&nbsp;</label>
                            <button type="submit" class="btn btn-primary w-100" id="btnFiltrarDesperdicios">
                                <i class="bi bi-search"></i> Filtrar
                            </button>
                        </div>
                        <div class="col-md-2">
                            <label>&nbsp;</label>
                            <a href="@Url.Action("DesperdiciosDetalle", new { })" class="btn btn-info w-100">
                                <i class="bi bi-table"></i> Ver Detalle
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- KPIs -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Total Desperdiciado</h6>
                    <h3 class="card-title text-danger" id="kpiTotalDesperdiciado">@Model.TotalDesperdiciado.ToString("F2")</h3>
                    <small class="text-muted">Unidades</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Transacciones</h6>
                    <h3 class="card-title text-primary" id="kpiTotalTransacciones">@Model.TotalTransacciones</h3>
                    <small class="text-muted">Registros</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Promedio x Transaccion</h6>
                    <h3 class="card-title text-info" id="kpiPromedioTransaccion">@Model.PromedioTransaccion.ToString("F2")</h3>
                    <small class="text-muted">Unidades</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Materiales Alto Riesgo</h6>
                    <h3 class="card-title text-warning" id="kpiProductosAltoRiesgo">@Model.MaterialesAltoDesperdicio.Count</h3>
                    <small class="text-muted">> 5% desperdicio</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Graficos -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <strong><i class="bi bi-pie-chart"></i> Desperdicios por Material</strong>
                </div>
                <div class="card-body chart-body">
                    <canvas id="chartPorProducto" height="300"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <strong><i class="bi bi-bar-chart"></i> Desperdicios por Tipo de Transaccion</strong>
                </div>
                <div class="card-body chart-body">
                    <canvas id="chartPorMaterial" height="300"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <strong><i class="bi bi-graph-up"></i> Tendencia Diaria de Desperdicios</strong>
                </div>
                <div class="card-body chart-body">
                    <canvas id="chartPorDia" height="100"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Materiales con Alto Desperdicio -->
    <div class="row mb-4" id="altoRiesgoContainer">
    @if (Model.MaterialesAltoDesperdicio.Any())
    {
        <div class="col-md-12">
            <div class="card border-warning">
                <div class="card-header bg-warning text-dark">
                <strong><i class="bi bi-exclamation-triangle"></i> Materiales con Alto Desperdicio (Requieren Atencion)</strong>
                </div>
                <div class="card-body" id="altoRiesgoBody">
                    <table class="table table-hover" id="altoRiesgoTable">
                        <thead class="table-light">
                            <tr>
                                <th>Material</th>
                                <th>% Desperdicio</th>
                                <th>Total Desperdiciado</th>
                                <th>Recomendacion</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var material in Model.MaterialesAltoDesperdicio.OrderByDescending(m => m.PorcentajeDesperdicio))
                            {
                                <tr class="@(material.PorcentajeDesperdicio > 15 ? "table-danger" : "table-warning")">
                                    <td><strong>@material.NombreMaterial</strong></td>
                                    <td>
                                        <span class="badge bg-@(material.PorcentajeDesperdicio > 15 ? "danger" : "warning")">
                                            @material.PorcentajeDesperdicio.ToString("F2")%
                                        </span>
                                    </td>
                                    <td>@material.TotalDesperdiciado.ToString("F2")</td>
                                    <td>@material.Recomendacion</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="col-md-12">
            <div class="alert alert-info">No hay materiales con alto desperdicio en el período seleccionado.</div>
        </div>
    }
    </div>
</div>

<script>
    // Datos desde el servidor
    var datosProductos = @Html.Raw(Json.Encode(Model.DesperdiciosPorProducto.Select(p => new { p.NombreProducto, p.TotalDesperdiciado }).ToList()));
    var datosOrigen = @Html.Raw(Json.Encode(Model.DesperdiciosPorOrigen.Select(o => new { o.Origen, o.TotalDesperdiciado, o.CantidadTransacciones }).ToList()));
    var datosDias = @Html.Raw(Json.Encode(Model.DesperdiciosPorDia.Select(d => new { Fecha = d.Fecha.ToString("yyyy-MM-dd"), d.TotalDesperdiciado }).ToList()));
    var datosAltoRiesgo = @Html.Raw(Json.Encode(Model.MaterialesAltoDesperdicio.Select(m => new { m.NombreMaterial, m.PorcentajeDesperdicio, m.TotalDesperdiciado, m.Recomendacion }).ToList()));

    var chartProducto = null;
    var chartOrigen = null;
    var chartDia = null;

    // Colores
    const coloresPrimarios = [
        '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF',
        '#FF9F40', '#FF6384', '#C9CBCF', '#4BC0C0', '#FF9F40'
    ];

    function destruirGraficos() {
        if (chartProducto) { chartProducto.destroy(); chartProducto = null; }
        if (chartOrigen) { chartOrigen.destroy(); chartOrigen = null; }
        if (chartDia) { chartDia.destroy(); chartDia = null; }
    }

    function renderAltoRiesgo(materiales) {
        var container = document.getElementById('altoRiesgoContainer');
        if (!container) return;

        if (!materiales || materiales.length === 0) {
            container.innerHTML = '<div class="col-md-12"><div class="alert alert-info">No hay materiales con alto desperdicio en el período seleccionado.</div></div>';
            return;
        }

        var rows = materiales.map(function (material) {
            var nombre = material.NombreMaterial || material.nombreMaterial || material.nombre || '';
            var porcentaje = Number(material.PorcentajeDesperdicio ?? material.porcentajeDesperdicio ?? material.porcentaje ?? 0);
            var total = Number(material.TotalDesperdiciado ?? material.totalDesperdiciado ?? material.cantidad ?? 0);
            var recomendacion = material.Recomendacion || material.recomendacion || '';
            var clase = porcentaje > 15 ? 'table-danger' : 'table-warning';
            var badge = porcentaje > 15 ? 'danger' : 'warning';
            return '<tr class="' + clase + '">'
                + '<td><strong>' + nombre + '</strong></td>'
                + '<td><span class="badge bg-' + badge + '">' + porcentaje.toFixed(2) + '%</span></td>'
                + '<td>' + total.toFixed(2) + '</td>'
                + '<td>' + recomendacion + '</td>'
                + '</tr>';
        }).join('');

        container.innerHTML = '<div class="col-md-12">'
            + '<div class="card border-warning">'
            + '<div class="card-header bg-warning text-dark"><strong><i class="bi bi-exclamation-triangle"></i> Materiales con Alto Desperdicio (Requieren Atencion)</strong></div>'
            + '<div class="card-body" id="altoRiesgoBody">'
            + '<table class="table table-hover" id="altoRiesgoTable">'
            + '<thead class="table-light"><tr><th>Material</th><th>% Desperdicio</th><th>Total Desperdiciado</th><th>Recomendacion</th></tr></thead>'
            + '<tbody>' + rows + '</tbody>'
            + '</table>'
            + '</div>'
            + '</div>'
            + '</div>';
    }

    function renderDashboard(data) {
        document.getElementById('kpiTotalDesperdiciado').textContent = Number(data.totalDesperdiciado || 0).toFixed(2);
        document.getElementById('kpiTotalTransacciones').textContent = data.totalTransacciones || 0;
        document.getElementById('kpiPromedioTransaccion').textContent = Number(data.promedioTransaccion || 0).toFixed(2);
        document.getElementById('kpiProductosAltoRiesgo').textContent = (data.materialesAltoDesperdicio || []).length;

        datosMateriales = data.porMaterial || [];
        datosOrigen = data.porOrigen || [];
        datosDias = data.porDia || [];
        datosAltoRiesgo = data.materialesAltoDesperdicio || [];

        destruirGraficos();

        if (datosMateriales.length > 0) {
            const ctxMaterial = document.getElementById('chartPorProducto').getContext('2d');
            chartProducto = new Chart(ctxMaterial, {
                type: 'pie',
                data: {
                    labels: datosMateriales.map(function (m) { return m.NombreMaterial || m.nombreMaterial || m.nombre || 'Sin nombre'; }),
                    datasets: [{
                        data: datosMateriales.map(function (m) { return Number(m.TotalDesperdiciado ?? m.totalDesperdiciado ?? m.cantidad ?? 0); }),
                        backgroundColor: coloresPrimarios
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    layout: {
                        padding: { left: 20, right: 20, top: 10, bottom: 10 }
                    },
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { color: '#FFFFFF' }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return context.label + ': ' + context.parsed.toFixed(2) + ' unidades';
                                }
                            }
                        }
                    }
                }
            });
        }

        if (datosOrigen.length > 0) {
            const ctxMaterial = document.getElementById('chartPorMaterial').getContext('2d');
            chartOrigen = new Chart(ctxMaterial, {
                type: 'bar',
                data: {
                    labels: datosOrigen.map(function (o) { return o.Origen || o.origen || 'SIN ORIGEN'; }),
                    datasets: [{
                        label: 'Cantidad Desperdiciada',
                        data: datosOrigen.map(function (o) { return Number(o.TotalDesperdiciado ?? o.cantidad ?? o.totalDesperdiciado ?? 0); }),
                        backgroundColor: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF'],
                        borderRadius: 6,
                        maxBarThickness: 28
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    layout: {
                        padding: { left: 22, right: 22, top: 10, bottom: 10 }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return context.parsed.x.toFixed(2) + ' unidades';
                                },
                                afterLabel: function (context) {
                                    var item = datosOrigen[context.dataIndex];
                                    return 'Transacciones: ' + (item ? (item.CantidadTransacciones || item.cantidadTransacciones || 0) : 0);
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: '#FFFFFF' },
                            grid: { color: 'rgba(255,255,255,0.15)' }
                        },
                        y: {
                            ticks: { color: '#FFFFFF' },
                            grid: { color: 'rgba(255,255,255,0.10)' }
                        }
                    }
                }
            });
        }

        if (datosDias.length > 0) {
            const ctxDia = document.getElementById('chartPorDia').getContext('2d');
            chartDia = new Chart(ctxDia, {
                type: 'line',
                data: {
                    labels: datosDias.map(function (d) {
                        var rawFecha = d.Fecha || d.fecha;
                        var fecha = new Date(rawFecha + 'T00:00:00');
                        return isNaN(fecha.getTime()) ? rawFecha : fecha.toLocaleDateString('es-CR');
                    }),
                    datasets: [{
                        label: 'Desperdicio (unidades)',
                        data: datosDias.map(function (d) { return Number(d.TotalDesperdiciado ?? d.cantidad ?? 0); }),
                        borderColor: '#22D3EE',
                        backgroundColor: 'rgba(34, 211, 238, 0.20)',
                        pointBackgroundColor: '#FFFFFF',
                        pointBorderColor: '#22D3EE',
                        pointRadius: 4,
                        tension: 0.3,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    layout: {
                        padding: { left: 20, right: 20, top: 10, bottom: 10 }
                    },
                    plugins: {
                        legend: {
                            display: true,
                            labels: { color: '#FFFFFF' }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return context.parsed.y.toFixed(2) + ' unidades';
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: '#FFFFFF' },
                            grid: { color: 'rgba(255,255,255,0.12)' }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: { color: '#FFFFFF' },
                            grid: { color: 'rgba(255,255,255,0.12)' }
                        }
                    }
                }
            });
        }

        renderAltoRiesgo(datosAltoRiesgo);
    }

    function refrescarDesperdicios() {
        var fechaInicio = document.getElementById('fechaInicio').value;
        var fechaFin = document.getElementById('fechaFin').value;
        var urlJson = '@Url.Action("DesperdiciosJSON", "Reportes")' + '?fechaInicio=' + encodeURIComponent(fechaInicio) + '&fechaFin=' + encodeURIComponent(fechaFin);

        fetch(urlJson, { credentials: 'same-origin' })
            .then(function (response) { return response.json(); })
            .then(function (data) {
                renderDashboard(data);
            })
            .catch(function () {
                var urlVista = '@Url.Action("Desperdicios", "Reportes")' + '?fechaInicio=' + encodeURIComponent(fechaInicio) + '&fechaFin=' + encodeURIComponent(fechaFin);
                window.location.href = urlVista;
            });
    }

    var formFiltro = document.getElementById('formFiltroDesperdicios');
    if (formFiltro) {
        formFiltro.addEventListener('submit', function (e) {
            e.preventDefault();
            refrescarDesperdicios();
        });
    }

    var btnFiltrar = document.getElementById('btnFiltrarDesperdicios');
    if (btnFiltrar) {
        btnFiltrar.addEventListener('click', function (e) {
            e.preventDefault();
            refrescarDesperdicios();
        });
    }

    var datosMateriales = @Html.Raw(Json.Encode(Model.DesperdiciosPorMaterial.Select(m => new { m.NombreMaterial, m.TotalDesperdiciado }).ToList()));

    renderDashboard({
        totalDesperdiciado: @Html.Raw(Json.Encode(Model.TotalDesperdiciado)),
        totalTransacciones: @Html.Raw(Json.Encode(Model.TotalTransacciones)),
        promedioTransaccion: @Html.Raw(Json.Encode(Model.PromedioTransaccion)),
        materialesAltoDesperdicio: datosAltoRiesgo,
        porProducto: datosProductos,
        porMaterial: datosMateriales,
        porOrigen: datosOrigen,
        porDia: datosDias
    });
</script>

<style>
    .desperdicios-analisis-page {
        margin-top: 1.5rem;
    }

    .desperdicios-analisis-page .card {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        border: none;
    }

    .desperdicios-analisis-page .card-header {
        font-weight: 600;
    }

    .desperdicios-analisis-page .chart-body {
        padding: 18px 26px;
        min-height: 320px;
    }

    .desperdicios-analisis-page #chartPorDia {
        min-height: 260px;
    }

    .desperdicios-analisis-page .card.border-warning table tbody td {
        color: #1f2937 !important;
    }

    .desperdicios-analisis-page .card.border-warning table thead th {
        color: #FFFFFF !important;
        background-color: #111827 !important;
        border-color: #1f2937 !important;
    }

    .desperdicios-analisis-page .card.border-warning .badge.bg-warning {
        color: #111827;
    }
</style>
