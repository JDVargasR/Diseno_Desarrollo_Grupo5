@model List<Proyecto_Diseno_Desarrollo_Grupo5.Models.Reportes.DesperdicioFilaVM>

@{
    ViewBag.Title = "Reportes - Detalle de Desperdicios";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2><i class="bi bi-table"></i> Detalle de Desperdicios</h2>
            <p class="text-muted">Listado completo de registros de desperdicios con filtros</p>
        </div>
    </div>

    <!-- Filtro de fechas -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-3">
                            <label for="fechaInicio" class="form-label">Fecha Inicio</label>
                            <input type="date" class="form-control" id="fechaInicio" name="fechaInicio" value="@ViewBag.FechaInicio" />
                        </div>
                        <div class="col-md-3">
                            <label for="fechaFin" class="form-label">Fecha Fin</label>
                            <input type="date" class="form-control" id="fechaFin" name="fechaFin" value="@ViewBag.FechaFin" />
                        </div>
                        <div class="col-md-2">
                            <label>&nbsp;</label>
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-search"></i> Filtrar
                            </button>
                        </div>
                        <div class="col-md-2">
                            <label>&nbsp;</label>
                            <a href="@Url.Action("Desperdicios", new { })" class="btn btn-info w-100">
                                <i class="bi bi-graph-up"></i> Ver Graficos
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de desperdicios -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <strong><i class="bi bi-list-ul"></i> Registros de Desperdicios (Mostrando @Model.Count de @ViewBag.TotalItems)</strong>
                </div>
                <div class="card-body p-0">
                    @if (Model.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Material</th>
                                        <th>Cantidad</th>
                                        <th>Producto</th>
                                        <th>Venta #</th>
                                        <th>Usuario</th>
                                        <th>Motivo</th>
                                        <th>Reutilizable</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <small>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</small>
                                            </td>
                                            <td>
                                                <strong>@item.Material</strong>
                                                <br />
                                                <small class="text-muted">@item.Unidad</small>
                                            </td>
                                            <td>
                                                <span class="badge bg-danger">@item.CantidadDesperdiciada.ToString("F2")</span>
                                            </td>
                                            <td>@item.Producto</td>
                                            <td>
                                                @if (item.IdVenta.HasValue)
                                                {
                                                    <span class="badge bg-info">#@item.IdVenta</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>@item.Usuario</td>
                                            <td>
                                                <small>@item.Motivo</small>
                                            </td>
                                            <td>
                                                <span class="badge bg-@(item.Reutilizable == "Si" ? "success" : "secondary")">
                                                    @item.Reutilizable
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info m-3">
                            <i class="bi bi-info-circle"></i> No hay registros de desperdicios en el período seleccionado.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Paginación -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="row">
            <div class="col-md-12">
                <nav aria-label="Paginacion">
                    <ul class="pagination justify-content-center">
                        @if (ViewBag.Page > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("DesperdiciosDetalle", new { fechaInicio = ViewBag.FechaInicio, fechaFin = ViewBag.FechaFin, page = 1 })">
                                    Primera
                                </a>
                            </li>
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("DesperdiciosDetalle", new { fechaInicio = ViewBag.FechaInicio, fechaFin = ViewBag.FechaFin, page = ViewBag.Page - 1 })">
                                    Anterior
                                </a>
                            </li>
                        }

                        @for (int i = Math.Max(1, ViewBag.Page - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.Page + 2); i++)
                        {
                            <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                                <a class="page-link" href="@Url.Action("DesperdiciosDetalle", new { fechaInicio = ViewBag.FechaInicio, fechaFin = ViewBag.FechaFin, page = i })">
                                    @i
                                </a>
                            </li>
                        }

                        @if (ViewBag.Page < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("DesperdiciosDetalle", new { fechaInicio = ViewBag.FechaInicio, fechaFin = ViewBag.FechaFin, page = ViewBag.Page + 1 })">
                                    Siguiente
                                </a>
                            </li>
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("DesperdiciosDetalle", new { fechaInicio = ViewBag.FechaInicio, fechaFin = ViewBag.FechaFin, page = ViewBag.TotalPages })">
                                    Última
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>

<style>
    .card {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        border: none;
    }
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }
</style>
