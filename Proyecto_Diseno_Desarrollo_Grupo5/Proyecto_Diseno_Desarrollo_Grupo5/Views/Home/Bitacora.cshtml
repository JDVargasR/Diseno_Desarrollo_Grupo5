@model System.Collections.Generic.List<Proyecto_Diseno_Desarrollo_Grupo5.EF.BITACORA>

@{
    ViewBag.Title = "Bitacora / Auditoria";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";

    var q = (ViewBag.Q ?? "").ToString();
    var accion = (ViewBag.Accion ?? "").ToString();
    var sort = (ViewBag.Sort ?? "fecha").ToString().ToLower();
    var dir = (ViewBag.Dir ?? "desc").ToString().ToLower();

    var acciones = ViewBag.Acciones as System.Collections.Generic.List<string>;

    var current = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);

    Func<string, string> nextDir = col => (sort == col && dir == "asc") ? "desc" : "asc";
    Func<string, IHtmlString> icon = col =>
    {
        if (sort != col) return new HtmlString("<i class='bi bi-arrow-down-up sort-icon'></i>");
        return new HtmlString(dir == "asc"
            ? "<i class='bi bi-sort-up sort-icon active'></i>"
            : "<i class='bi bi-sort-down sort-icon active'></i>");
    };
}

@section styles{
    <link rel="stylesheet" href="~/StaticFiles/css/Usuarios.css" />
    <link rel="stylesheet" href="~/StaticFiles/css/Bitacora.css" />
}

<main class="usuarios-page bitacora-page" data-no-reveal="true">
    <div class="container py-4">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h2 class="mb-0">Bitácora / Auditoría</h2>
                <small class="text-muted">Registro de acciones realizadas en el sistema</small>
            </div>
        </div>

        <form method="get" class="usuarios-filtros card p-3 mb-3">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-5">
                    <label class="form-label">Buscar</label>
                    <input type="text" name="q" class="form-control" value="@q" placeholder="Accion o descripcion..." />
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label">Acción</label>
                    <select class="form-select" name="accion">
                        <option value="">Todas</option>
                        @if (acciones != null)
                        {
                            foreach (var a in acciones)
                            {
                                <option value="@a" @(accion == a ? "selected" : "")>@a</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-6 col-md-2 d-grid">
                    <button class="btn btn-dark" type="submit">
                        <i class="bi bi-search me-1"></i> Filtrar
                    </button>
                </div>

                <div class="col-6 col-md-2 d-grid">
                    <a class="btn btn-outline-secondary" href="@Url.Action("Bitacora")">
                        Limpiar
                    </a>
                </div>
            </div>
        </form>

        <div class="card usuarios-card">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 110px;">#</th>
                            <th>
                                <a class="sort-link" href="@Url.Action("Bitacora", new { q = q, accion = accion, sort = "usuario", dir = nextDir("usuario"), page = 1 })">
                                    Usuario @icon("usuario")
                                </a>
                            </th>
                            <th style="width: 180px;">
                                <a class="sort-link" href="@Url.Action("Bitacora", new { q = q, accion = accion, sort = "accion", dir = nextDir("accion"), page = 1 })">
                                    Acción @icon("accion")
                                </a>
                            </th>
                            <th>
                                <a class="sort-link" href="@Url.Action("Bitacora", new { q = q, accion = accion, sort = "descripcion", dir = nextDir("descripcion"), page = 1 })">
                                    Descripción @icon("descripcion")
                                </a>
                            </th>
                            <th style="width: 190px;">
                                <a class="sort-link" href="@Url.Action("Bitacora", new { q = q, accion = accion, sort = "fecha", dir = nextDir("fecha"), page = 1 })">
                                    Fecha @icon("fecha")
                                </a>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var b in Model)
                            {
                                <tr>
                                    <td>@b.ID_BITACORA</td>
                                    <td>@(b.USUARIOS != null ? b.USUARIOS.NOMBRE : ("Usuario #" + b.ID_USUARIO))</td>
                                    <td><span class="badge bg-info text-dark">@b.ACCION</span></td>
                                    <td>@b.DESCRIPCION</td>
                                    <td>@b.FECHA.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No hay registros de bitácora para mostrar.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @{
            int start = Math.Max(1, current - 2);
            int end = Math.Min(totalPages, current + 2);
        }

        <nav aria-label="Paginación" class="mt-3">
            <ul class="pagination">
                <li class="page-item @(current == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Bitacora", new { q = q, accion = accion, sort = sort, dir = dir, page = current - 1 })">Anterior</a>
                </li>

                @for (int i = start; i <= end; i++)
                {
                    <li class="page-item @(i == current ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Bitacora", new { q = q, accion = accion, sort = sort, dir = dir, page = i })">@i</a>
                    </li>
                }

                <li class="page-item @(current >= totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Bitacora", new { q = q, accion = accion, sort = sort, dir = dir, page = current + 1 })">Siguiente</a>
                </li>
            </ul>
        </nav>
    </div>
</main>