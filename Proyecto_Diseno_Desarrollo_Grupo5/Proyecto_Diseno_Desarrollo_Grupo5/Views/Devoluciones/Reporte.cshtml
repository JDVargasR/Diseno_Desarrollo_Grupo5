@model System.Collections.Generic.List<Proyecto_Diseno_Desarrollo_Grupo5.Models.DevolucionReporteFilaVM>
@using Proyecto_Diseno_Desarrollo_Grupo5.EF
@{
    ViewBag.Title = "Reporte de devoluciones";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";

    var anio = (int)(ViewBag.Anio ?? DateTime.Today.Year);
    var mes = (int)(ViewBag.Mes ?? DateTime.Today.Month);
    var idCategoria = ViewBag.IdCategoria as int?;
    var motivo = (ViewBag.Motivo ?? "").ToString();

    var categorias = ViewBag.Categorias as List<CATEGORIAS>;
}

@section styles{
    <link rel="stylesheet" href="~/StaticFiles/css/Cliente.css" />
}

<div class="container" style="max-width:1200px; padding-top:30px;">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h2 class="page-title">Reporte mensual de devoluciones</h2>
            <div class="page-subtitle">Frecuencia, motivo y valor monetario</div>
        </div>
        <a class="btn btn-outline-dark" href="@Url.Action("Index","Devoluciones")">Volver</a>
    </div>

    <form method="get" class="page-section mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label" style="font-weight:700;">Año</label>
                <input class="form-control" type="number" name="anio" value="@anio" />
            </div>
            <div class="col-md-2">
                <label class="form-label" style="font-weight:700;">Mes</label>
                <input class="form-control" type="number" min="1" max="12" name="mes" value="@mes" />
            </div>
            <div class="col-md-3">
                <label class="form-label" style="font-weight:700;">Categoría</label>
                <select class="form-select" name="idCategoria">
                    <option value="">Todas</option>
                    @if (categorias != null)
                    {
                        foreach (var c in categorias)
                        {
                            <option value="@c.ID_CATEGORIA" @(idCategoria == c.ID_CATEGORIA ? "selected" : "")>@c.NOMBRE</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label" style="font-weight:700;">Motivo contiene</label>
                <input class="form-control" name="motivo" value="@motivo" />
            </div>
            <div class="col-12 d-grid mt-2">
                <button class="btn btn-dark" type="submit">Generar reporte</button>
            </div>
        </div>
    </form>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="cardx p-3">
                <div class="text-muted">Total devoluciones</div>
                <div style="font-size:28px; font-weight:900;">@ViewBag.TotalFrecuencia</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="cardx p-3">
                <div class="text-muted">Valor monetario total</div>
                <div style="font-size:28px; font-weight:900;">?@(((decimal)(ViewBag.TotalValor ?? 0)).ToString("N2"))</div>
            </div>
        </div>
    </div>

    <div class="page-section">
        <div class="cardx table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Motivo</th>
                        <th>Cantidad devuelta</th>
                        <th>Frecuencia</th>
                        <th>Valor monetario</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var r in Model)
                        {
                            <tr>
                                <td>@r.Producto</td>
                                <td>@r.Categoria</td>
                                <td>@r.Motivo</td>
                                <td>@r.CantidadDevuelta.ToString("N2")</td>
                                <td>@r.Frecuencia</td>
                                <td>?@r.ValorMonetario.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted" style="padding:18px;">No hay datos para el filtro seleccionado.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
