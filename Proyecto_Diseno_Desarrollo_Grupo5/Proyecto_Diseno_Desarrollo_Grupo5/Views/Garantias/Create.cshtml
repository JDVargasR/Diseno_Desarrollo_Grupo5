@model Proyecto_Diseno_Desarrollo_Grupo5.Models.Garantias.SolicitudGarantiaCrearVM
@{
    ViewBag.Title = "Nueva solicitud de garantía";
}

@section styles{
    <link rel="stylesheet" href="~/StaticFiles/css/Cliente.css" />
}

<div class="container" style="max-width:900px; padding-top:30px;">

    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h2 class="page-title">Nueva solicitud</h2>
            <div class="page-subtitle">Registro de solicitud de garantía</div>
        </div>
        <a class="btn btn-outline-secondary" href="@Url.Action("Index","Garantias")">Volver</a>
    </div>

    @if (TempData["ERR"] != null)
    {
        <div class="alert alert-danger cardx" style="padding:12px 14px;">@TempData["ERR"]</div>
    }

    <div class="page-section">
        @using (Html.BeginForm("Create", "Garantias", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label class="form-label" style="font-weight:700;">Venta</label>
                    @Html.DropDownListFor(m => m.IdVenta, Model.Ventas, "Seleccione...", new { @class = "form-select", required = "required" })
                </div>

                <div class="col-12 col-md-4">
                    <label class="form-label" style="font-weight:700;">Cliente</label>
                    @Html.DropDownListFor(m => m.IdCliente, Model.Clientes, "Seleccione...", new { @class = "form-select", required = "required" })
                </div>

                <div class="col-12 col-md-4">
                    <label class="form-label" style="font-weight:700;">Producto</label>
                    @Html.DropDownListFor(m => m.IdProducto, Model.Productos, "Seleccione...", new { @class = "form-select", required = "required" })
                </div>

                <div class="col-12">
                    <label class="form-label" style="font-weight:700;">Descripción de la falla</label>
                    @Html.TextAreaFor(m => m.DescripcionFalla, 4, 40, new { @class = "form-control", required = "required", placeholder = "Describa el problema presentado..." })
                </div>

                <div class="col-12 d-flex justify-content-end gap-2">
                    <a class="btn btn-light" href="@Url.Action("Index","Garantias")">Cancelar</a>
                    <button class="btn btn-primary btn-primary-pill" type="submit">Registrar solicitud</button>
                </div>
            </div>
        }
    </div>
</div>
